{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yazooblu1",
  "main": "dist/server.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6c65ec53853d48b19b44f8f1934e5ef7"
    }
  ]
}
